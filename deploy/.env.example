# Copy to .env and edit. Consumed by docker-compose.yml.

# Absolute path on the Docker host to the git checkout of this repo.
# Bind-mounted into BOTH the builder and the claude container at /repo, so the
# agent's edits are instantly visible to the builder (no git-sync).
# Provision it once:  git clone https://github.com/steilerDev/universal-smart-home
# then place a real secrets.yaml at that checkout's root (gitignored, survives sync).
ESPHOME_REPO_DIR=/opt/docker/home_esp

# Absolute path on the Docker host to the Claude config/login dir to reuse.
# Mounted into the claude container at /root/.claude so it reuses your existing
# login + settings (no API key in-repo). Usually the host user's ~/.claude —
# give the ABSOLUTE path (docker does not expand ~).
CLAUDE_CONFIG_DIR=/root/.claude

# Existing Authentik outpost Docker network name (docker network ls).
AUTHENTIK_NETWORK=authentik
