# Copy to .env and edit. Consumed by docker-compose.yml.

# Absolute path on the Docker host to the git checkout of this repo.
# Provision it once:  git clone https://github.com/steilerDev/universal-smart-home
# then place a real secrets.yaml at that checkout's root (gitignored, survives sync).
ESPHOME_REPO_DIR=/srv/esphome/universal-smart-home

# Existing Authentik outpost Docker network name (docker network ls).
AUTHENTIK_NETWORK=authentik

# Branch the builder tracks, and how often it polls (seconds).
ESPHOME_GIT_REF=main
ESPHOME_GIT_INTERVAL=15
