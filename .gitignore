# ESPHome build artifacts
.esphome/

# Secrets — never commit (root only; devices/secrets.yaml is a tracked symlink)
/secrets.yaml

# Python virtualenv
venv/
.venv/

# OS
.DS_Store
Thumbs.db
/__pycache__/
*.pyc

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# ESPHome Device Builder state (written into devices/ on the build host — disposable,
# device identity lives in YAML substitutions, so keep it out of git)
devices/.device-builder*.json
devices/.device-builder-peer-link-key.bin
devices/dashboard-jobs/

# Local deploy env (builder/Authentik credentials)
deploy/.env

# KiCad files
.history
.kicad-push
*-unsaved-export-*.kicad_prl